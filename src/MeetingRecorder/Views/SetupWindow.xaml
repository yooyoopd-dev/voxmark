<Window x:Class="MeetingRecorder.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vox Mark — Setup" Height="680" Width="820"
        Background="{StaticResource WindowBrush}"
        Icon="/wpf_icon.ico"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="New meeting" FontSize="22" Foreground="{StaticResource TextBrush}" Margin="0,0,0,18"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="TITLE" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="TitleBox" Text="New Meeting" FontSize="15"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="INPUT DEVICE — say something to test the level below" FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="DeviceCombo" Padding="10" FontSize="14"/>
            <Grid Margin="0,8,0,0" Height="8">
                <Rectangle Fill="{StaticResource WellBrush}" RadiusX="4" RadiusY="4"/>
                <Rectangle x:Name="LevelBar" Fill="{StaticResource AccentBrush}" RadiusX="4" RadiusY="4"
                           HorizontalAlignment="Left" Width="0"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="ROSTER — up to 12 speakers, key order is add order" FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>

            <ListBox x:Name="RosterList" Grid.Row="1" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="]" Foreground="{StaticResource TextMutedBrush}" Margin="4,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Role}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="✕" Width="24" Height="24" Background="Transparent" BorderThickness="0" 
                                    Foreground="{StaticResource TextMutedBrush}" Click="OnRemoveSpeakerClick" Tag="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="Name" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="NewSpeakerName" Padding="8"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                    <TextBlock Text="Role" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="NewSpeakerRole" Padding="8"/>
                </StackPanel>
                <Button Grid.Column="2" Grid.ColumnSpan="2" Content="＋ Add" Margin="0,0,0,0" Padding="14,8" VerticalAlignment="Bottom" Click="OnAddSpeaker"/>
            </Grid>
        </Grid>

        <Button Grid.Row="4" x:Name="StartButton" HorizontalAlignment="Right"
                Margin="0,20,0,0" Padding="20,12" FontSize="15" Click="OnStartRecording">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource TextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource RecBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="Start recording" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
