<Window x:Class="MeetingRecorder.Views.RecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vox Mark — Recording"
        Height="800" Width="1180" MinHeight="760" MinWidth="1180"
        Background="{StaticResource WindowBrush}"
        Icon="/wpf_icon.ico"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Inline stop confirmation — not a modal, per the design guide. -->
        <Border x:Name="ConfirmBanner" Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource RecBrush}" BorderThickness="1" CornerRadius="6"
                Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed">
            <TextBlock x:Name="ConfirmBannerText" Foreground="{StaticResource TextBrush}" FontSize="14"/>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <Ellipse x:Name="RecDot" Width="12" Height="12" Fill="{StaticResource RecBrush}" Margin="0,4,14,0"/>
                <TextBlock x:Name="ClockText" Text="00:00:00" FontSize="34" Foreground="{StaticResource TextBrush}" FontFamily="Consolas"/>
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="StatusText" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="MarkCountText" Text="Marks 0" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <Button x:Name="PauseButton" Content="⏸ Pause" Padding="12,6" Margin="0,0,10,0" Click="OnPauseClick"/>
                <Button x:Name="StopButton" Content="⏹ Stop" Padding="12,6" Click="OnStopClick"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource WellBrush}" CornerRadius="6" Height="70" Margin="0,0,0,14" Padding="8">
            <StackPanel x:Name="LevelBarsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
        </Border>

        <UniformGrid x:Name="TileGrid" Grid.Row="3" Columns="3"/>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="MARKS · LIVE" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
            <ListBox x:Name="MarksList" MaxHeight="140" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="12.5"/>
        </StackPanel>

        <TextBlock Grid.Row="5"
                   Text="1–9,0 mark speaker · Shift+1/2 speakers 11–12 · Space close · Ctrl+Z undo · Ctrl+P pause · Esc stop"
                   FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0"/>
    </Grid>
</Window>
