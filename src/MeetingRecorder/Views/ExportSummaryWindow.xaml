<Window x:Class="MeetingRecorder.Views.ExportSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vox Mark — Finishing" Height="560" Width="640"
        Background="{StaticResource WindowBrush}"
        Icon="/wpf_icon.ico"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" FontSize="22" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
        <TextBlock x:Name="SubText" Grid.Row="1" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                   Margin="0,0,0,16" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="SESSION SUMMARY" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
            <StackPanel x:Name="SummaryPanel"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="폴더 열기 (Open folder)" Padding="14,10" Margin="0,0,10,0" Click="OnOpenFolder"/>
            <Button Content="완료 (Done)" Padding="20,10" Click="OnDone"/>
        </StackPanel>
    </Grid>
</Window>
