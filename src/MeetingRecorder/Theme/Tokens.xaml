<!--
  Design tokens — design guide section 02.

  Every colour in the app comes from here. The guide is explicit that
  borders are a 1px hairline (never a shadow) and that the only real
  shadow in the product is under the always-on-top mini bar, so there is
  no elevation ramp: surfaces separate by ground colour plus a hairline.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <Color x:Key="VoidColor">#FF0E1019</Color>
    <Color x:Key="WindowColor">#FF161826</Color>
    <Color x:Key="ChromeColor">#FF1A1C29</Color>
    <Color x:Key="WellColor">#FF1C1E2C</Color>
    <Color x:Key="SurfaceColor">#FF232532</Color>
    <Color x:Key="SurfaceAccentColor">#FF2B2741</Color>

    <SolidColorBrush x:Key="VoidBrush" Color="{StaticResource VoidColor}"/>
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}"/>
    <SolidColorBrush x:Key="ChromeBrush" Color="{StaticResource ChromeColor}"/>
    <SolidColorBrush x:Key="WellBrush" Color="{StaticResource WellColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAccentBrush" Color="{StaticResource SurfaceAccentColor}"/>

    <!-- Hairlines -->
    <SolidColorBrush x:Key="HairlineBrush" Color="#FF3F424D"/>
    <SolidColorBrush x:Key="HairlineSoftBrush" Color="#FF2C2F3D"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#14E9E9ED"/>

    <!-- Accent -->
    <Color x:Key="AccentColor">#FF9184D9</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#FF5D5294"/>
    <SolidColorBrush x:Key="AccentEdgeBrush" Color="#FF423A6A"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFB5ABFC"/>
    <SolidColorBrush x:Key="AccentTextStrongBrush" Color="#FFD2CEFD"/>
    <SolidColorBrush x:Key="AccentTintBrush" Color="#1F9184D9"/>

    <!-- Recording state -->
    <Color x:Key="RecColor">#FFE58095</Color>
    <SolidColorBrush x:Key="RecBrush" Color="{StaticResource RecColor}"/>
    <SolidColorBrush x:Key="RecEdgeBrush" Color="#FF5D3038"/>
    <SolidColorBrush x:Key="RecTextBrush" Color="#FFF7D5DC"/>
    <SolidColorBrush x:Key="RecTintBrush" Color="#1AE58095"/>

    <!-- Text ramp -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFE9E9ED"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFCFD3E5"/>
    <SolidColorBrush x:Key="TextBodyBrush" Color="#FFB2B6CA"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#FF9397AB"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF75798C"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#FF595D6C"/>

    <!-- Status -->
    <SolidColorBrush x:Key="GoodBrush" Color="#FF4EC39B"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#FFC9A04F"/>

    <!--
      The guide asks for Inter and JetBrains Mono. Bundling font files
      would break the "one small self-contained exe" promise in CLAUDE.md,
      so this substitutes the closest shipping Windows 11 faces and lets
      WPF fall back down the list on older builds. Timecodes stay
      monospaced with tabular figures so digits do not jitter while
      counting.
    -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="UiDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
